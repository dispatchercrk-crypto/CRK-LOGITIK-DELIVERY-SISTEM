# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WHATSAPP_API_URL: Optional server-side WhatsApp Gateway HTTP endpoint (e.g. https://api.fonnte.com/send or custom WA webhook URL).
WHATSAPP_API_URL=""

# WHATSAPP_API_TOKEN: Optional server-side authorization token for the WhatsApp Gateway.
WHATSAPP_API_TOKEN=""

# WHATSAPP_DEFAULT_TARGET: Default operational Dispatcher WhatsApp number (e.g. 6281234567890).
WHATSAPP_DEFAULT_TARGET=""

# GOOGLE_SPREADSHEET_ID: Optional default Google Spreadsheet ID for fleet synchronization.
GOOGLE_SPREADSHEET_ID=""
